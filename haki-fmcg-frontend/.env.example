# =============================================================================
# Haki Frontend - Environment Configuration
# =============================================================================

# Backend REST API Base URL
# For local development with Vite proxy: leave blank or set to http://localhost:8000
# For Vercel production: set to your deployed backend URL (e.g., https://api.yourdomain.com or Render/Railway URL)
# If left unset, requests default to relative path (/api)
VITE_API_URL=

# Optional Microservice Endpoints (if deployed separately)
# VITE_PDF_URL=https://pdf-service.yourdomain.com
# VITE_SPEC_URL=https://spec-service.yourdomain.com
# VITE_VENDOR_URL=https://vendor-service.yourdomain.com
# VITE_BID_URL=https://bid-service.yourdomain.com
